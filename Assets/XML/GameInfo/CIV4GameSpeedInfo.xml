<!-- Game Speed -->
<!-- NOTE: If you remove any of these you need to update GameInfo/CultureLevelInfos.xml. Also you will need to update the GlobalDefines.xml if you remove GAMESPEED_STANDARD -->
<Civ4GameSpeedInfo xmlns="x-schema:CIV4GameInfoSchema.xml">
	<GameSpeedInfos>
		<GameSpeedInfo> <!-- custom: GAMESPEED_NORMAL -->
			<Type>GAMESPEED_NORMAL</Type>
			<Description>TXT_KEY_GAMESPEED_NORMAL</Description>
			<Help>TXT_KEY_GAMESPEED_NORMAL_HELP</Help>
			<iGrowthPercent>100</iGrowthPercent>
			<iTrainPercent>100</iTrainPercent>
			<iConstructPercent>100</iConstructPercent>
			<iCreatePercent>100</iCreatePercent>
			<iResearchPercent>100</iResearchPercent>
			<iBuildPercent>100</iBuildPercent>
			<iImprovementPercent>100</iImprovementPercent>
			<iGreatPeoplePercent>100</iGreatPeoplePercent>
			<iCulturePercent>100</iCulturePercent>
			<iAnarchyPercent>100</iAnarchyPercent>
			<iBarbPercent>100</iBarbPercent>
			<iFeatureProductionPercent>100</iFeatureProductionPercent>
			<iUnitDiscoverPercent>100</iUnitDiscoverPercent>
			<iUnitHurryPercent>100</iUnitHurryPercent>
			<iUnitTradePercent>100</iUnitTradePercent>
			<iUnitGreatWorkPercent>100</iUnitGreatWorkPercent>
			<iGoldenAgePercent>100</iGoldenAgePercent>
			<iHurryPercent>100</iHurryPercent>
			<iHurryConscriptAngerPercent>100</iHurryConscriptAngerPercent>
			<iInflationPercent>30</iInflationPercent>
			<iInflationOffset>-90</iInflationOffset>
			<!-- custom: added the iUnitCostPercent and iExtraFreeOutsideUnits fields that were missing to match marathon and fix a bug, see code comment as of now at top of this file, plus known issue as of now 92 for details. -->
			<iUnitCostPercent>100</iUnitCostPercent>
			<iExtraFreeOutsideUnits>0</iExtraFreeOutsideUnits>
			<iVictoryDelayPercent>100</iVictoryDelayPercent>
			<!-- advc.910: Changed all of the turn counts -->
			<GameTurnInfos>
				<!-- -50,000 to -30,000 (20,000y) -> 4 turns @ 5,000 y/turn (60,000 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>60000</iMonthIncrement><iTurnsPerIncrement>4</iTurnsPerIncrement></GameTurnInfo>
				<!-- -30,000 to -20,000 (10,000y) -> 4 turns @ 2,500 y/turn (30,000 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>30000</iMonthIncrement><iTurnsPerIncrement>4</iTurnsPerIncrement></GameTurnInfo>
				<!-- -20,000 to -15,000 (5,000y) -> 5 turns @ 1,000 y/turn (12,000 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>12000</iMonthIncrement><iTurnsPerIncrement>5</iTurnsPerIncrement></GameTurnInfo>
				<!-- -15,000 to -12,000 (3,000y) -> 4 turns @ 750 y/turn (9,000 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>9000</iMonthIncrement><iTurnsPerIncrement>4</iTurnsPerIncrement></GameTurnInfo>
				<!-- -12,000 to -7,500 (4,500y) -> 9 turns @ 500 y/turn (6,000 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>6000</iMonthIncrement><iTurnsPerIncrement>9</iTurnsPerIncrement></GameTurnInfo>
				<!-- -7,500 to -4,500 (3,000y) -> 12 turns @ 250 y/turn (3,000 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>3000</iMonthIncrement><iTurnsPerIncrement>12</iTurnsPerIncrement></GameTurnInfo>
				<!-- -4,500 to -3,000 (1,500y) -> 12 turns @ 125 y/turn (1,500 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>1500</iMonthIncrement><iTurnsPerIncrement>12</iTurnsPerIncrement></GameTurnInfo>
				<!-- -3,000 to -2,200 (800y) -> 16 turns @ 50 y/turn (600 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>600</iMonthIncrement><iTurnsPerIncrement>16</iTurnsPerIncrement></GameTurnInfo>
				<!-- -2,200 to -1,480 (720y) -> 18 turns @ 40 y/turn (480 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>480</iMonthIncrement><iTurnsPerIncrement>18</iTurnsPerIncrement></GameTurnInfo>
				<!-- -1,480 to -1,000 (480y) -> 16 turns @ 30 y/turn (360 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>360</iMonthIncrement><iTurnsPerIncrement>16</iTurnsPerIncrement></GameTurnInfo>
				<!-- -1,000 to 500 (1,500y) -> 50 turns @ 30 y/turn (360 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>360</iMonthIncrement><iTurnsPerIncrement>50</iTurnsPerIncrement></GameTurnInfo>
				<!-- 500 to 1,300 (800y) -> 40 turns @ 20 y/turn (240 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>240</iMonthIncrement><iTurnsPerIncrement>40</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,300 to 1,400 (100y) -> 10 turns @ 10 y/turn (120 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>120</iMonthIncrement><iTurnsPerIncrement>10</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,400 to 1,600 (200y) -> 20 turns @ 10 y/turn (120 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>120</iMonthIncrement><iTurnsPerIncrement>20</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,600 to 1,750 (150y) -> 30 turns @ 5 y/turn (60 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>60</iMonthIncrement><iTurnsPerIncrement>30</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,750 to 1,790 (40y) -> 10 turns @ 4 y/turn (48 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>48</iMonthIncrement><iTurnsPerIncrement>10</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,790 to 1,880 (90y) -> 30 turns @ 3 y/turn (36 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>36</iMonthIncrement><iTurnsPerIncrement>30</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,880 to 1,900 (20y) -> 10 turns @ 2 y/turn (24 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>24</iMonthIncrement><iTurnsPerIncrement>10</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,900 to 1,980 (80y) -> 40 turns @ 2 y/turn (24 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>24</iMonthIncrement><iTurnsPerIncrement>40</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,980 to 1,990 (10y) -> 10 turns @ 1 y/turn (12 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>12</iMonthIncrement><iTurnsPerIncrement>10</iTurnsPerIncrement></GameTurnInfo>
				<!-- 1,990 to 2,040 (50y) -> 50 turns @ 1 y/turn (12 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>12</iMonthIncrement><iTurnsPerIncrement>50</iTurnsPerIncrement></GameTurnInfo>
				<!-- 2,040 to 2,070 (30y) -> 30 turns @ 1 y/turn (12 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>12</iMonthIncrement><iTurnsPerIncrement>30</iTurnsPerIncrement></GameTurnInfo>
				<!-- 2,070 to 2,080 (10y) -> 20 turns @ 0.5 y/turn (6 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>6</iMonthIncrement><iTurnsPerIncrement>20</iTurnsPerIncrement></GameTurnInfo>
				<!-- 2,080 to 2,105 (25y) -> 50 turns @ 0.5 y/turn (6 mo/turn) -->
				<GameTurnInfo><iMonthIncrement>6</iMonthIncrement><iTurnsPerIncrement>50</iTurnsPerIncrement></GameTurnInfo>
				<!-- custom: old code from base advciv timeline kept for info -->
				<!-- Avoid an odd number here - otherwise all the year numbers in the next period (2 years per turn) will be odd. -->
				<!--<GameTurnInfo><iMonthIncrement>60</iMonthIncrement><iTurnsPerIncrement>26</iTurnsPerIncrement></GameTurnInfo>-->
			</GameTurnInfos>
		</GameSpeedInfo>
	</GameSpeedInfos>
</Civ4GameSpeedInfo>
